{
  "version": 3,
  "configurePresets": [
    {
      "name": "mac-vcpkg",
      "displayName": "macOS Release (vcpkg)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/mac-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "windows-vcpkg",
      "displayName": "Windows Win32 (vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mac-vcpkg",
      "configurePreset": "mac-vcpkg"
    },
    {
      "name": "windows-vcpkg",
      "configurePreset": "windows-vcpkg",
      "configuration": "Release"
    }
  ]
}
